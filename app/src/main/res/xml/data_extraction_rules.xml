<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ defense-in-depth. Encly intentionally transfers no app-private data
   through cloud backup or device-to-device migration. This covers the v2 vault,
   biometric slot metadata, encrypted preferences, SQLCipher database and any future
   private files without relying on fragile filename allow/deny lists.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
