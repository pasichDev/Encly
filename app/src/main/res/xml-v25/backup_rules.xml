<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy auto-backup rules (API < 31). allowBackup is false, so no backup
   runs; these excludes are defense-in-depth for the encrypted DB and
   security prefs.
-->
<full-backup-content>
    <exclude domain="database" path="database.db" />
    <exclude domain="sharedpref" path="security_prefs.xml" />
    <exclude domain="sharedpref" path="secure_prefs.xml" />
    <exclude domain="sharedpref" path="integrity_prefs.xml" />
</full-backup-content>
