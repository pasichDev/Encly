<?xml version="1.0" encoding="utf-8"?>
<!--
   Security-first policy: Encly vault state is device-local and must never participate
   in Auto Backup. android:allowBackup="false" is the primary control; these exclusions
   are defense-in-depth and deliberately cover whole app-private backup domains so a
   future preference/database filename cannot accidentally become transferable.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
