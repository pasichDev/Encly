<?xml version="1.0" encoding="utf-8"?>
<!--
   Secret-notes app: no sensitive data may leave the device.
   allowBackup is already false; these rules are defense-in-depth so the
   encrypted DB and security prefs are excluded from cloud backup AND
   device-to-device transfer on API 31+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="database.db" />
        <exclude domain="sharedpref" path="security_prefs.xml" />
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="sharedpref" path="integrity_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="database.db" />
        <exclude domain="sharedpref" path="security_prefs.xml" />
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="sharedpref" path="integrity_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
